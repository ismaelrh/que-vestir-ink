<div class="layout layout--col layout--center-x p--xs">

  {% if is_error %}
     <div class="stretch-y h--min-0 flex flex--center-y flex--center-x w--100">
        <img
          class="image image-dither image--contain w--full h--full" src="{{ sprite_url }}" alt="Error">
     </div>
    <div class="title text--center mt--xs">
          {{ error_message }}
        </div>

  {% else %}

    <div class="stretch-y h--min-0 flex flex--center-y flex--center-x w--100">
      
      <img 
        class="image image-dither image--contain w--full h--full"
        src="{{ sprite_url }}" 
        alt="Conjunto"
      >
    </div>

    {% if show_future_suggestions == 'on' and today_tip != '' %}
       <div class="title title--large outfit-tip text--center mt--xs">
        {{ today_tip }}
      </div>
    {% endif %}

  {% endif %}

</div>

{%- if show_bottom_bar == 'on' -%}
  <div class="title_bar">
    <span class="title title--small">{{ outfit_title }}</span>
    <span class="instance">{{ location_label }}</span>
  </div>
{%- endif -%}
