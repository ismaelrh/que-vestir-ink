      {%- assign arr = hints_colder_hot_11 -%}
    {%- elsif scenario == 'wetter' -%}
      {%- assign arr = hints_wetter_11 -%}
    {%- elsif scenario == 'drier' -%}
      {%- assign arr = hints_drier_11 -%}
    {%- elsif scenario == 'wetter_warmer' -%}
      {%- assign arr = hints_wetter_warmer_11 -%}
    {%- elsif scenario == 'wetter_colder' -%}
      {%- assign arr = hints_wetter_colder_11 -%}
    {%- elsif scenario == 'drier_warmer' -%}
      {%- assign arr = hints_drier_warmer_11 -%}
    {%- elsif scenario == 'drier_colder' -%}
      {%- assign arr = hints_drier_colder_11 -%}
    {%- endif -%}
  {%- endif -%}

  {%- if arr != nil -%}
    {%- assign n = arr | size -%}
    {%- if n > 0 -%}
      {%- assign idx = local_days | modulo: n -%}
      {%- assign today_tip = arr[idx] -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

