{%- comment %}
Note to self:
Pick the final sprite slug.
By default I use weather_slug.
If a theme is active and there is no error,
I switch to "<theme>_<weather_slug>".
{%- endcomment %}
{%- comment %}
Note to self:
Theme whitelist. A theme only replaces the sprite for slugs I have
actually drawn, everything else falls back to the base sprite
instead of a broken image. 'ALL' means the full set exists.
Slugs are wrapped in commas so the contains check cannot
accidentally match hot_dry inside very_hot_dry.
Add slugs as I draw them, e.g. ',freezing_dry,freezing_snow,cold_dry,'
{%- endcomment %}
{%- assign theme_whitelist = '' -%}
{%- case active_theme -%}
  {%- when 'ny' -%}
    {%- assign theme_whitelist = 'ALL' -%}
  {%- when 'pi' -%}
    {%- assign theme_whitelist = 'ALL' -%}
  {%- when 'force' -%}
    {%- assign theme_whitelist = 'ALL' -%}
  {%- when 'bike' -%}
    {%- assign theme_whitelist = 'ALL' -%}
  {%- when 'okt' -%}
    {%- assign theme_whitelist = 'ALL' -%}
  {%- when 'spooky' -%}
    {%- assign theme_whitelist = 'ALL' -%}
  {%- when 'thanks' -%}
    {%- assign theme_whitelist = 'ALL' -%}
  {%- when 'xmas' -%}
    {%- assign theme_whitelist = 'ALL' -%}
  {%- when 'ghd' -%}
    {%- assign theme_whitelist = '' -%}
  {%- when 'tdf' -%}
    {%- assign theme_whitelist = '' -%}
  {%- when 'krampus' -%}
    {%- assign theme_whitelist = '' -%}
  {%- when 'nikolo' -%}
    {%- assign theme_whitelist = '' -%}
{%- endcase -%}

{%- assign sprite_slug = weather_slug -%}
{%- if active_theme != '' and is_error == false -%}
  {%- assign slug_probe = ',' | append: weather_slug | append: ',' -%}
  {%- if theme_whitelist == 'ALL' or theme_whitelist contains slug_probe -%}
    {%- assign sprite_slug = active_theme | append: '_' | append: weather_slug -%}
  {%- endif -%}
{%- endif -%}

{%- if is_error -%}
  {%- assign sprite_url = error_sprite_url -%}
  {%- assign fallback_sprite_url = error_sprite_url -%}
{%- else -%}
  {%- assign sprite_url = sprite_base_url | append: sprite_slug | append: '.png' -%}
  {%- comment %}
  Note to self:
  fallback_sprite_url is always the plain, untheme'd sprite.
  The display markup can use it for an onerror fallback:
  <img src="{{ sprite_url }}" onerror="this.onerror=null;this.src='{{ fallback_sprite_url }}'">
  {%- endcomment %}
  {%- assign fallback_sprite_url = sprite_base_url | append: weather_slug | append: '.png' -%}
{%- endif -%}

